{
  "name": "3D-Druck: Neue Bestellung → Pushover + Eingangsbestätigung",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "new-order",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-new-order",
      "name": "Neue Bestellung (Webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [260, 300],
      "webhookId": "new-order"
    },
    {
      "parameters": {
        "userId": "DEINE_PUSHOVER_USER_KEY",
        "message": "={{ $json.body.text }}\n\nAntwort an: {{ $json.body.replyTo || 'keine Adresse' }}",
        "additionalFields": {
          "title": "={{ $json.body.subject }}",
          "priority": 0,
          "sound": "pushover"
        }
      },
      "id": "pushover-send",
      "name": "Pushover-Push an Jan",
      "type": "n8n-nodes-base.pushover",
      "typeVersion": 1,
      "position": [560, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "id": "has-reply-to",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true },
              "leftValue": "={{ $json.body.replyTo }}",
              "rightValue": ""
            }
          ]
        },
        "options": {}
      },
      "id": "if-has-address",
      "name": "Kundenadresse vorhanden?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [560, 400]
    },
    {
      "parameters": { "amount": 30 },
      "id": "cb4b0f62-4e0f-4f74-8ef5-6e96c32279f3",
      "name": "Wait 30sec.",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [690, 400],
      "webhookId": "819be00d-0197-4850-b762-d418c2b4708a"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  from: '3D-Druck Luetje <onboarding@resend.dev>',\n  to: [$json.body.replyTo],\n  reply_to: 'jan@luetje.me',\n  subject: 'Ihre Anfrage ist angekommen (' + $json.body.subject + ')',\n  text: 'Hallo,\\n\\nvielen Dank für Ihre Anfrage — sie ist bei mir eingegangen und ich schaue sie mir persönlich an.\\n\\nIch melde mich bei Ihnen, sobald ich die Anfrage geprüft habe. Bis dahin ist noch nichts bestellt und es entstehen Ihnen keine Kosten.\\n\\nZu Ihrer Anfrage:\\n\\n' + $json.body.text + '\\n\\nSie können auf diese Mail direkt antworten, wenn sich noch etwas ändern soll.\\n\\nViele Grüße\\nJan Lütje\\n3D-Druck Lütje\\njan@luetje.me\\nhttps://drucken.luetje.me'\n}) }}",
        "options": {}
      },
      "id": "resend-confirmation",
      "name": "Eingangsbestätigung an Kunden",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [820, 400],
      "credentials": {
        "httpHeaderAuth": { "id": "resend", "name": "Resend API (Authorization: Bearer re_...)" }
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Neue Bestellung (Webhook)": {
      "main": [[
        { "node": "Pushover-Push an Jan", "type": "main", "index": 0 },
        { "node": "Kundenadresse vorhanden?", "type": "main", "index": 0 }
      ]]
    },
    "Kundenadresse vorhanden?": {
      "main": [[{ "node": "Wait 30sec.", "type": "main", "index": 0 }]]
    },
    "Wait 30sec.": {
      "main": [[{ "node": "Eingangsbestätigung an Kunden", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
